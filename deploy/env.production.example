# Production environment. Copy to .env on the server and fill in every value marked CHANGE.
# Never commit the real file. Keep a copy of APP_KEY somewhere safe: encrypted data cannot be read without it.
APP_NAME="Azana Farms ERP"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                       # CHANGE: php artisan key:generate --show, once, on first install only
APP_URL=https://erp.azanafarms.com   # the ERP: links in e-mails and notifications point here. The website and the API take their address from the request.

# Which pages each name serves (routes/web.php, the Filament panel). The bare azanafarms.com is redirected to WEBSITE_HOST by nginx.
# The mobile app uses https://api.azanafarms.com/api/v1 : the API routes need no host setting, nginx limits that name to the API.
WEBSITE_HOST=www.azanafarms.com
ERP_HOST=erp.azanafarms.com

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=azana_erp
DB_USERNAME=azana           # CHANGE: a dedicated account, not root
DB_PASSWORD=                # CHANGE

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120
SESSION_DOMAIN=                # leave empty: each name keeps its own cookie, so a website cookie is never sent to the ERP
SANCTUM_STATEFUL_DOMAINS=      # empty: the mobile app uses bearer tokens only (the default list names localhost)
SANCTUM_EXPIRATION=43200       # minutes: a phone signs in again after 30 days
LOG_DAILY_DAYS=30
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3700     # must exceed the longest job (a backup may run 3600 s), or a running job is handed out again
CACHE_STORE=database
FILESYSTEM_DISK=local

# Mail leaves through the SMTP service of the e-mail host the company already uses (an erp@azanafarms.com mailbox), so SPF, DKIM and DMARC
# stay exactly as they are. Do not send from the VPS itself (port 25 is blocked on most VPS plans). See docs/deployment/DNS_AND_EMAIL_CUTOVER.md.
MAIL_MAILER=smtp
# MAIL_SCHEME: leave it out. Laravel then picks implicit TLS for port 465 and STARTTLS for 587 by itself (MailManager).
MAIL_HOST=                     # CHANGE: the outgoing server name the mail host gives for the mailbox
MAIL_PORT=587                  # 587 (STARTTLS) or 465 (implicit TLS): whichever the mail host documents
MAIL_USERNAME=                 # CHANGE: the full mailbox address
MAIL_PASSWORD=                 # CHANGE: the mailbox password
MAIL_FROM_ADDRESS=erp@azanafarms.com
MAIL_FROM_NAME="${APP_NAME}"

# Backups (docs/BACKUP_AND_RESTORE.md). The off-site disk must be somewhere other than this server.
BACKUP_OFFSITE_DISK=s3      # CHANGE: needs `composer require league/flysystem-aws-s3-v3 "^3.0"` and the AWS_* values below
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=8
BACKUP_KEEP_MONTHS=12
BACKUP_RESTORE_TEST_DATABASE=azana_restore_test   # scratch database for the weekly restore test; the DB user needs rights on it
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=                 # private bucket, versioning and server-side encryption on
